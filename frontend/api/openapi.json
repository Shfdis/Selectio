{"openapi":"3.0.1","info":{"title":"Selectio Development API","version":"v1"},"paths":{"/user":{"post":{"tags":["auth"],"summary":"Register a new account","description":"Creates a pending account and sends a verification email.","operationId":"RegisterUser","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/User"}}},"required":true},"responses":{"200":{"description":"OK"},"409":{"description":"Conflict"},"503":{"description":"Service Unavailable","content":{"application/problem\u002Bjson":{"schema":{"$ref":"#/components/schemas/ProblemDetails"}}}}}}},"/user/verify/{uuid}":{"post":{"tags":["auth"],"summary":"Verify account by UUID (POST)","description":"Verifies a pending account using the email verification UUID.","operationId":"VerifyUser","parameters":[{"name":"uuid","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK"},"400":{"description":"Bad Request"},"404":{"description":"Not Found"}}},"get":{"tags":["auth"],"summary":"Verify account by UUID (GET)","description":"Verifies a pending account using the email verification UUID from browser links.","operationId":"VerifyUserGet","parameters":[{"name":"uuid","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK"},"400":{"description":"Bad Request"},"404":{"description":"Not Found"}}}},"/user/verify":{"post":{"tags":["auth"],"summary":"Authenticate and issue JWT","description":"Validates credentials and returns an access token with user info.","operationId":"LoginUser","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"OK"},"401":{"description":"Unauthorized"}}}},"/user/identify":{"get":{"tags":["auth"],"summary":"Get authenticated user","description":"Returns account details for the authenticated user, resolved from gateway headers or JWT.","operationId":"IdentifyUser","responses":{"200":{"description":"OK"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/user/delete":{"delete":{"tags":["auth"],"summary":"Delete authenticated user","description":"Deletes the authenticated user\u0027s account.","operationId":"DeleteUser","responses":{"200":{"description":"OK"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/test/emails-sent":{"get":{"tags":["auth"],"operationId":"GetTestEmailsSent","responses":{"200":{"description":"OK"}}}},"/api/books":{"get":{"tags":["Books"],"summary":"List books","description":"Returns all books ordered by popularity descending, then id ascending. Pagination: page defaults to 1, pageSize defaults to 20 (max 100). Each item includes aggregate averageRating from book comments and library ratings when available.","parameters":[{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/BookDto"}}}}}}}},"/api/books/recommended":{"get":{"tags":["Books"],"summary":"Recommended books for current user","description":"Requires the authenticated user (gateway injects user id). Ranks books with embeddings using pgvector cosine distance (HNSW index) against the user\u0027s library-derived embedding. Books already in the user\u0027s library are excluded. Returns an empty list if the user has no embedding yet or no eligible books exist.","parameters":[{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/BookDto"}}}}},"401":{"description":"Unauthorized"}}}},"/api/books/popular-by-genre":{"get":{"tags":["Books"],"summary":"Popular books, optionally filtered by genre","description":"Ranks books by persisted popularity descending, tie-broken by book id ascending. When genre is provided, matches case-insensitively against the book\u0027s genre field (substring match). Pagination: page defaults to 1, pageSize defaults to 20 (max 100).","parameters":[{"name":"genre","in":"query","schema":{"type":"string"}},{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/BookDto"}}}}}}}},"/api/books/{id}":{"get":{"tags":["Books"],"summary":"Get book by id","description":"Returns one book with averageRating (from book comments \u002B library ratings). If the request includes an authenticated user, also returns that user\u0027s library status and rating for this book when present.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookDto"}}}},"404":{"description":"Not Found"}}}},"/api/books/search":{"get":{"tags":["Books"],"summary":"Search books by title or author","description":"query is required. Case-insensitive match on title OR author (substring). Results are ordered by popularity descending, then id ascending. Pagination: page defaults to 1, pageSize defaults to 20 (max 100).","parameters":[{"name":"query","in":"query","schema":{"type":"string"}},{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/BookDto"}}}}},"400":{"description":"Bad Request"}}}},"/api/books/popular":{"get":{"tags":["Books"],"summary":"Popular books across all genres","description":"Same ranking as popular-by-genre but without a genre filter: popularity descending, then by book id ascending. Pagination: page defaults to 1, pageSize defaults to 20 (max 100).","parameters":[{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/BookDto"}}}}}}}},"/api/posts/{id}/comments":{"get":{"tags":["Comments"],"summary":"List comments on a post","description":"Returns post comments oldest-first with authorUsername resolved from user profiles (fallback user{id}).","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/PostCommentDto"}}}}},"404":{"description":"Not Found"}}},"post":{"tags":["Comments"],"summary":"Add a comment to a post","description":"Creates a comment as the authenticated user; response includes authorUsername.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateCommentRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PostCommentDto"}}}},"400":{"description":"Bad Request"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/api/comments/{id}":{"put":{"tags":["Comments"],"summary":"Update a post comment","description":"Updates comment text for a comment owned by the authenticated user (enforced at gateway).","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateCommentRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PostCommentDto"}}}},"400":{"description":"Bad Request"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}},"delete":{"tags":["Comments"],"summary":"Delete a post comment","description":"Deletes a comment row (owner enforced at gateway).","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/api/books/{id}/comments":{"get":{"tags":["Comments"],"summary":"List book comments (reviews)","description":"Returns book reviews oldest-first with authorUsername from profiles.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/BookCommentDto"}}}}},"404":{"description":"Not Found"}}},"post":{"tags":["Comments"],"summary":"Add a book review","description":"Creates a rating\u002Btext review; response includes authorUsername.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateBookCommentRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookCommentDto"}}}},"400":{"description":"Bad Request"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/api/users/me/book-comments":{"get":{"tags":["Comments"],"summary":"List my book reviews with book summary","description":"Returns the authenticated user\u0027s book comments with a nested book summary for profile/reviews UIs.","parameters":[{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/MyBookCommentItemDto"}}}}},"401":{"description":"Unauthorized"}}}},"/api/users/{id}/communities":{"get":{"tags":["Communities"],"summary":"List user communities","description":"Public: returns communities the given user id has joined, ordered by community id. Pagination: page defaults to 1, pageSize defaults to 20 (max 100). Each item includes subscriberCount for that community.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CommunityDto"}}}}}}}},"/api/communities":{"get":{"tags":["Communities"],"summary":"List communities","description":"Public list ordered by community id. Optional query: case-insensitive substring match on community name (ILIKE). Optional genre: case-insensitive substring match on the community genre field. Pagination: page defaults to 1, pageSize defaults to 20 (max 100). Each item includes subscriberCount (CommunityMembers rows for that community).","parameters":[{"name":"query","in":"query","schema":{"type":"string"}},{"name":"genre","in":"query","schema":{"type":"string"}},{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CommunityDto"}}}}}}},"post":{"tags":["Communities"],"summary":"Create community","description":"Creates a community owned by the authenticated user, then inserts an owner membership row so the creator is subscribed immediately. Name is required and must be unique (trimmed, exact match). Description, coverUrl, and genre are optional strings (trimmed; empty strings allowed).","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateCommunityRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommunityDto"}}}},"400":{"description":"Bad Request"},"401":{"description":"Unauthorized"}}}},"/api/communities/{id}":{"get":{"tags":["Communities"],"summary":"Get community by ID","description":"Returns one community by id with subscriberCount computed from CommunityMembers. Does not include whether the current user is a member; use join or list user communities for that.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommunityDto"}}}},"404":{"description":"Not Found"}}},"put":{"tags":["Communities"],"summary":"Update community (owner only)","description":"Owner-only: updates name, description, coverUrl, and/or genre. Null fields are left unchanged. Name must remain unique among communities (excluding this id).","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateCommunityRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommunityDto"}}}},"400":{"description":"Bad Request"},"401":{"description":"Unauthorized"},"403":{"description":"Forbidden"},"404":{"description":"Not Found"}}}},"/api/communities/{id}/join":{"post":{"tags":["Communities"],"summary":"Join a community","description":"Idempotent subscribe: if the user is not a member yet, creates a row with role Member. If already a member (including Owner from create), returns the existing membership without error.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommunityMemberDto"}}}},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/api/communities/{id}/leave":{"post":{"tags":["Communities"],"summary":"Leave a community","description":"Removes the authenticated user\u0027s CommunityMembers row for this community. Returns 404 if they were not a member.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/health":{"get":{"tags":["crud"],"responses":{"200":{"description":"OK"}}}},"/version":{"get":{"tags":["crud"],"responses":{"200":{"description":"OK"}}}},"/internal/posts/{id}":{"get":{"tags":["Internal"],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"}}}},"/internal/post-comments/{id}":{"get":{"tags":["Internal"],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"}}}},"/internal/communities/{id}":{"get":{"tags":["Internal"],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"}}}},"/internal/communities/{communityId}/members/{userId}":{"get":{"tags":["Internal"],"parameters":[{"name":"communityId","in":"path","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"userId","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"}}}},"/api/books/{id}/library":{"post":{"tags":["Library"],"summary":"Add book to my library","description":"Idempotent: if the user does not yet have this book in UserBooks, inserts a row with status from the body or WantToRead. If already present, returns the existing row without changing status.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddToLibraryRequest"}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserLibraryStateDto"}}}},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}},"put":{"tags":["Library"],"summary":"Update library status for a book","description":"Sets UserBooks.Status for the authenticated user and book id. Returns 404 if the book is not in the user\u0027s library.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateLibraryStatusRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserLibraryStateDto"}}}},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}},"delete":{"tags":["Library"],"summary":"Remove book from my library","description":"Deletes the UserBooks row for the authenticated user and book id. Returns 404 if not in the library.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LibraryRemovedDto"}}}},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/api/books/{id}/rate":{"put":{"tags":["Library"],"summary":"Set my star rating for a library book","description":"Rating must be 1\u20135. Book must already be in the user\u0027s library (404 otherwise).","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetRatingRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserLibraryStateDto"}}}},"400":{"description":"Bad Request"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/api/users/{id}/books":{"get":{"tags":["Library"],"summary":"List books in a user\u0027s library","description":"Public: returns books the user has in UserBooks with pagination (page default 1, pageSize default 20, max 100). Optional status filter matches UserBooks.Status exactly.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"status","in":"query","schema":{"$ref":"#/components/schemas/LibraryStatus"}},{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserLibraryItemDto"}}}}}}}},"/api/users/favorites":{"get":{"tags":["LikesFavorites"],"summary":"List my favorited posts","description":"Returns posts the authenticated user has favorited, newest favorites first, with basic post fields and when it was favorited. Pagination: page defaults to 1, pageSize defaults to 20 (max 100).","parameters":[{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/FavoritePostDto"}}}}},"401":{"description":"Unauthorized"}}}},"/api/posts/{id}/like":{"post":{"tags":["LikesFavorites"],"summary":"Like a post","description":"Idempotent: creates a PostLikes row for (postId, current user) if missing; if already liked, returns liked=true without error. Does not change post content or status.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}},"delete":{"tags":["LikesFavorites"],"summary":"Unlike a post","description":"Idempotent: removes the user\u0027s like for this post if it exists; if not liked, returns liked=false without error.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/api/posts/{id}/favorite":{"post":{"tags":["LikesFavorites"],"summary":"Favorite a post","description":"Idempotent: creates a FavoritePosts row for (postId, current user) if missing; if already favorited, returns favorited=true without error. Use GET /api/users/favorites to list favorited posts for the current user.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}},"delete":{"tags":["LikesFavorites"],"summary":"Unfavorite a post","description":"Idempotent: removes the user\u0027s favorite for this post if it exists; if not favorited, returns favorited=false without error.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/api/communities/{id}/suggestions":{"get":{"tags":["Moderation"],"summary":"List suggested posts for a community","description":"Returns posts in Suggested status for the given community id, newest first. Public at the CRUD layer; when called through the API gateway, only community moderators can access this path.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"},"404":{"description":"Not Found"}}}},"/api/posts/{id}/approve":{"post":{"tags":["Moderation"],"summary":"Approve a suggested post","description":"Only valid when the post status is Suggested; sets status to Published and refreshes embeddings for the post/community/book graph. Returns 409 if the post exists but is not in Suggested status. When called through the API gateway, only community moderators can access this path.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ModerationDecisionResponse"}}}},"404":{"description":"Not Found"},"409":{"description":"Conflict"}}}},"/api/posts/{id}/reject":{"post":{"tags":["Moderation"],"summary":"Reject a suggested post","description":"Only valid when the post status is Suggested; deletes the post and runs the same embedding cleanup as a normal delete. Returns 409 if the post exists but is not in Suggested status. When called through the API gateway, only community moderators can access this path.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK"},"404":{"description":"Not Found"},"409":{"description":"Conflict"}}}},"/api/communities/{id}/posts":{"get":{"tags":["Posts"],"summary":"List posts in a community","description":"Returns published posts for a community (newest first) with feed-shaped payloads. When the request includes X-User-Id, likedByCurrentUser and favoritedByCurrentUser reflect that user.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/PostFeedItemDto"}}}}}}}},"/api/users/me/feed":{"get":{"tags":["Posts"],"summary":"Get personalized community feed","description":"Returns published posts from communities the user has joined. When a user embedding exists (from books in their library), posts with embeddings are ranked by cosine similarity (higher first), then by recency; posts without embeddings follow, ordered by recency. Without a user embedding, ordering is purely by CreatedAt (newest first).","parameters":[{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/PostFeedItemDto"}}}}},"401":{"description":"Unauthorized"}}}},"/api/posts":{"post":{"tags":["Posts"],"summary":"Create a published post","description":"Creates a new published post in a community for the authenticated user.","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePostRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PostDto"}}}},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/api/posts/suggest":{"post":{"tags":["Posts"],"summary":"Suggest a post for moderation","description":"Creates a suggested post that requires moderator approval before becoming visible.","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePostRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PostDto"}}}},"401":{"description":"Unauthorized"},"404":{"description":"Not Found"}}}},"/api/posts/recommended":{"get":{"tags":["Posts"],"summary":"Get recommended posts","description":"Returns personalized published posts ranked by pgvector cosine distance (HNSW index) against the user\u0027s library-derived embedding. Includes author username, nested book summary, like/comment counts, and whether the current user liked or favorited the post.","parameters":[{"name":"page","in":"query","schema":{"type":"integer","format":"int32"}},{"name":"pageSize","in":"query","schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/PostFeedItemDto"}}}}},"401":{"description":"Unauthorized"}}}},"/api/posts/{id}":{"get":{"tags":["Posts"],"summary":"Get post by ID","description":"Returns one post as a feed-shaped payload (author username, book summary, counts, liked/favorited for the current user when X-User-Id is present). Suggested posts are hidden unless the X-Allow-Suggested header is true.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PostFeedItemDto"}}}},"404":{"description":"Not Found"}}},"put":{"tags":["Posts"],"sum