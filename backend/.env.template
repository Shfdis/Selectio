# Copy to .env and fill in values. Compose loads backend/.env for all services.

JWT_SECRET_KEY=
JWT_ISSUER=SelectioAuth
JWT_AUDIENCE=SelectioUsers

# Shared secret: gateway sends this to CRUD (X-Gateway-Internal-Token) and image-service on internal routes.
GATEWAY_INTERNAL_TOKEN=

# Public base URL used in image upload JSON responses (must match how clients reach the gateway).
GATEWAY_PUBLIC_BASE_URL=http://localhost:8000

EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Selectio
EMAIL_BASE_URL=http://localhost:8080
EMAIL_ALLOW_INSECURE_SSL=false

